{
  "compilerOptions": {
    "baseUrl": "./",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@common": ["src/components/common"],
      "@common/*": ["src/components/common/*"],
      "@pages": ["src/pages"],
      "@pages/*": ["src/pages/*"],
      "@hooks/*": ["src/hooks/*"],
      "@data/*": ["src/data/*"],
      "@assets": ["src/assets"],
      "@assets/*": ["src/assets/*"]
    }
  }
}
